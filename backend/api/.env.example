# Regista API settings. Copy to backend/api/.env for local development; in Azure these are app settings (Bicep sets
# the deployment-specific ones). Real environment variables win over this file. There are no keys: every Azure call
# uses a Microsoft Entra token (az login locally, managed identity in Azure). Empty = that service is off.

# --- Deployment-specific (set by infra/ as app settings) ---------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_REASONING_DEPLOYMENT=reasoning
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_SERVICES_ENDPOINT=
AZURE_AI_SERVICES_REGION=
AZURE_AI_SERVICES_RESOURCE_ID=
COSMOS_ENDPOINT=
COSMOS_DATABASE=regista
STORAGE_ACCOUNT_URL=
EVENTHUB_FQDN=
EVENTHUB_NAME=match-events
EVENTHUB_CONSUMER_GROUP=api
LIVE_SOURCE=replay
WEBPUBSUB_ENDPOINT=
WEBPUBSUB_HUB=regista
ONELAKE_WORKSPACE=
ONELAKE_LAKEHOUSE=
APPLICATIONINSIGHTS_CONNECTION_STRING=
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000
# REGISTA_OFFLINE=1          # force the offline engines even when endpoints are set

# --- Service contracts: defaults match the Azure APIs this build is tested against -----------------------------
AZURE_COGNITIVE_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_TOKEN_REFRESH_MARGIN_S=120
HTTP_TIMEOUT_S=20
AZURE_OPENAI_API_PATH=/openai/v1/
AZURE_OPENAI_TIMEOUT_S=40
AZURE_OPENAI_MAX_RETRIES=2
AZURE_SPEECH_TTS_URL=https://{region}.tts.speech.microsoft.com/cognitiveservices/v1
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_TRANSLATOR_PATH=/translator/text/v3.0/translate
AZURE_TRANSLATOR_API_VERSION=3.0
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01
AZURE_CONTENT_SAFETY_ANALYZE_PATH=/contentsafety/text:analyze
AZURE_CONTENT_SAFETY_SHIELD_PATH=/contentsafety/text:shieldPrompt
AZURE_CONTENT_SAFETY_MAX_CHARS=9000
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY=4
ONELAKE_DFS_ENDPOINT=https://onelake.dfs.fabric.microsoft.com
