# Build context for the API image is the repo root (az acr build -f backend/api/Dockerfile .).
# data/ MUST stay in the context: the image bundles data/reference (CC0 results) and data/matches.
.git
.github
.vscode
**/.venv
**/venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.env
**/.env.*
**/local.settings.json
frontend/web/dist
infra
docs
scripts
backend/functions
# Data Forge what-ifs generated locally (git ignores them too): only the curated real rebuilds ship in the image
data/matches/whatif-*
# Personal workbench (decks, screenshots, helper scripts)
workbench
