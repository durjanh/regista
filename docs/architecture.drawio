<mxCell id="n28" value="&lt;b&gt;regista-api&lt;/b&gt; (FastAPI, Python 3.12)&lt;br&gt;• Data Forge: conditioned engine + planted scenarios&lt;br&gt;• Analytics: xG, xT, win prob, PPDA, shapes&lt;br&gt;• Detectors + Grader (truth loop)&lt;br&gt;• Live engine: moments, insights → SSE&lt;br&gt;• Agent runtime (Agent Framework)&lt;br&gt;• MCP server /mcp (14 tools)&lt;br&gt;• Scouting · Dugout · Ops (SLO, cost)&lt;br&gt;• Verifier + fair-commentary guardrail" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#E8F3FF;strokeColor=#0078D4;fontColor=#1A1A1A;" vertex="1" parent="n26"><mxGeometry x="255" y="40" width="250" height="175" as="geometry"/></mxCell>
<mxCell id="n29" value="&lt;b&gt;Job: regista-feeder&lt;/b&gt;&lt;br&gt;replays a match into Event Hubs&lt;br&gt;at real or accelerated speed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#E8F3FF;strokeColor=#0078D4;fontColor=#1A1A1A;" vertex="1" parent="n26"><mxGeometry x="15" y="135" width="220" height="60" as="geometry"/></mxCell>
