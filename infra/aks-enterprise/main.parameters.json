{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "aksPrivateCluster": {
      "value": "${AKS_PRIVATE_CLUSTER=true}"
    },
    "aksAuthorizedIpRanges": {
      "value": "${AKS_AUTHORIZED_IP_RANGES=}"
    },
    "apimPublisherEmail": {
      "value": "${APIM_PUBLISHER_EMAIL}"
    },
    "azureDevOpsOrganizationUrl": {
      "value": "${AZURE_DEVOPS_ORG_URL=}"
    },
    "devOpsInfrastructurePrincipalId": {
      "value": "${DEVOPS_INFRASTRUCTURE_PRINCIPAL_ID=}"
    },
    "budgetContactEmail": {
      "value": "${BUDGET_EMAIL=}"
    },
    "budgetAmount": {
      "value": "${BUDGET_AMOUNT=1400}"
    },
    "budgetStartDate": {
      "value": "2026-10-01"
    },
    "chatModel": {
      "value": {
        "name": "${CHAT_MODEL_NAME=gpt-5.4-mini}",
        "version": "${CHAT_MODEL_VERSION=2026-03-17}"
      }
    },
    "reasoningModel": {
      "value": {
        "name": "${REASONING_MODEL_NAME=gpt-5.5}",
        "version": "${REASONING_MODEL_VERSION=2026-04-24}"
      }
    },
    "modelSku": {
      "value": "${MODEL_SKU=GlobalStandard}"
    },
    "staticWebAppLocation": {
      "value": "${STATIC_WEB_APP_LOCATION=eastus2}"
    },
    "aksNodeVmSize": {
      "value": "${AKS_NODE_VM_SIZE=Standard_D4ds_v6}"
    },
    "aksNodeMinCount": {
      "value": "${AKS_NODE_MIN_COUNT=2}"
    },
    "aksNodeMaxCount": {
      "value": "${AKS_NODE_MAX_COUNT=2}"
    },
    "oneLakeWorkspace": {
      "value": "${ONELAKE_WORKSPACE=}"
    },
    "oneLakeLakehouse": {
      "value": "${ONELAKE_LAKEHOUSE=}"
    },
    "staticWebAppSku": {
      "value": "${STATIC_WEB_APP_SKU=Free}"
    },
    "aksTier": {
      "value": "${AKS_TIER=Free}"
    },
    "webPubSubSku": {
      "value": "${WEBPUBSUB_SKU=Standard_S1}"
    },
    "webPubSubUnits": {
      "value": "${WEBPUBSUB_UNITS=1}"
    },
    "apiServiceSettingsOverrides": {
      "value": "${API_SERVICE_SETTINGS}"
    }
  }
}
